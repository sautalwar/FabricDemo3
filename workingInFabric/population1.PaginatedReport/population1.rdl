  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Populationcountry19501999changed</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		'Population-country-1950-1999'[Location],
		'Population-country-1950-1999'[AgeGrp],
		"CountLocID", CALCULATE(COUNTA('Population-country-1950-1999'[LocID])),
		"SumTime", CALCULATE(SUM('Population-country-1950-1999'[Time])),
		"SumAgeGrpStart", CALCULATE(SUM('Population-country-1950-1999'[AgeGrpStart]))
	)

EVALUATE
	__DS0Core

ORDER BY
	'Population-country-1950-1999'[Location], 'Population-country-1950-1999'[AgeGrp]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Population-country-1950-1999'[Location],
			'Population-country-1950-1999'[AgeGrp],
			"CountLocID", CALCULATE(COUNTA('Population-country-1950-1999'[LocID])),
			"SumTime", CALCULATE(SUM('Population-country-1950-1999'[Time])),
			"SumAgeGrpStart", CALCULATE(SUM('Population-country-1950-1999'[AgeGrpStart]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			'Population-country-1950-1999'[Location],
			1,
			'Population-country-1950-1999'[AgeGrp],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	'Population-country-1950-1999'[Location], 'Population-country-1950-1999'[AgeGrp]</wa:PreviewCommandText>
      </Query>
